PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/shelves.db
# NODE_ENV=production for a built deployment behind HTTPS.
# PUBLIC_ORIGIN=https://your-shelves-domain.example
# Resend delivery. Both values are required in production for account emails.
# RESEND_API_KEY=re_...
# SHELVES_EMAIL_FROM=Shelves <hello@your-shelves-domain.example>
# Or select EmailJS. Its template IDs and keys stay on the server.
# SHELVES_EMAIL_PROVIDER=emailjs
EMAILJS_SERVICE_ID=shelves_support
EMAILJS_PUBLIC_KEY=3ZtczxR13SBT4kyq3
# EMAILJS_PRIVATE_KEY=
EMAILJS_RESET_TEMPLATE_ID=template_pr8irmp
# EMAILJS_VERIFY_TEMPLATE_ID=

# Use postgres after the verified import; sqlite works without cloud credentials.
DATABASE_ENGINE=sqlite
DATABASE_SCHEMA=shelves

# Server-only Google Books API key
GOOGLE_BOOKS_API_KEY=

# Comma-separated immutable account IDs for Shelves administrator badges.
SHELVES_ADMIN_IDS=
