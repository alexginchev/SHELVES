PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/shelves.db
# NODE_ENV=production for a built deployment behind HTTPS.
# PUBLIC_ORIGIN=https://your-shelves-domain.example

# Use postgres after the verified import; sqlite works without cloud credentials.
DATABASE_ENGINE=sqlite
DATABASE_SCHEMA=shelves

# Server-only Google Books API key
GOOGLE_BOOKS_API_KEY=

# Comma-separated immutable account IDs for Shelves administrator badges.
SHELVES_ADMIN_IDS=
